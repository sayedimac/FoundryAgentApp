@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebApp</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">WebApp</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Chat</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home"
                               asp-action="Privacy">Privacy</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - WebApp - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @{
        var instrumentationKey = Configuration["APPINSIGHTS_INSTRUMENTATIONKEY"];
    }
    @if (!string.IsNullOrEmpty(instrumentationKey))
    {
        <script type="text/javascript">
            !function (v, y, T) {/* Application Insights SDK Loader */var S = v.location, k = "script", C = "instrumentationKey", z = "ingestionendpoint", q = "disableExceptionTracking", D = "ai.device.", F = "toLowerCase", G = "crossOrigin", K = "POST", N = "appInsightsSDK", W = T.name || "appInsights", X = (T.name || "appInsights") + "Queue"; (T.sri || T.url) && ((y.queue = y.queue || []).push(["snippet", 6]), d = v.document, i = d.createElement(k), i.src = T.url || "https://js.monitor.azure.com/scripts/b/ai.3.gbl.min.js", T.sri && i.setAttribute("integrity", T.sri), i.setAttribute("data-ai-name", N), d.head.appendChild(i)); try { y.cookie = d.cookie } catch (p) { } function a(n) { y[n] = function () { var t = arguments; y.queue.push(function () { y[n].apply(y, t) }) } } var e = "track", t = "TrackPage", n = "TrackEvent"; a("flush"), a("set" + t), a("clear" + t), a(e + "Dependency"), a(e + "Event"), a(e + "Exception"), a(e + "PageView"), a(e + "Request"), a(e + "Trace"), a("start" + t), a("stop" + t), a("addTelemetryInitializer"), a("setAuthenticatedUserContext"), a("clearAuthenticatedUserContext"), a("getSender"), v[N] = W, y[C] = T[C], y[z] = T[z], y[q] = T[q] || !1 }(window, window["appInsights"] = window["appInsights"] || {}, {
            url: "https://js.monitor.azure.com/scripts/b/ai.3.gbl.min.js",
            instrumentationKey: "@instrumentationKey",
            disableExceptionTracking: false,
            });

            // Click Analytics Auto-collection Plugin for HEART analytics
            var defined = (function () {
            var clickPluginScript = document.createElement('script');
            clickPluginScript.src = 'https://js.monitor.azure.com/scripts/b/ext/ai.clck.3.gbl.min.js';
            clickPluginScript.onload = function () {
            var clickPluginInstance = new Microsoft.ApplicationInsights.ClickAnalyticsPlugin();
            var clickPluginConfig = {
            autoCapture: true,
            dataTags: {
            useDefaultContentNameOrId: true
            }
            };
            appInsights.addPlugin(clickPluginInstance, 'ClickAnalyticsPlugin', clickPluginConfig);
            };
            document.head.appendChild(clickPluginScript);
            })();
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>