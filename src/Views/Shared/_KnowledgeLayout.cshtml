<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Shipping Knowledge</title>
    <link rel="stylesheet" href="~/css/knowledge.css" asp-append-version="true" />
</head>
<body>
    <header class="knowledge-header">
        <a class="knowledge-brand" asp-controller="ShippingKnowledge" asp-action="Items">Shipping Knowledge</a>
        <nav aria-label="Knowledge navigation">
            <a asp-controller="Home" asp-action="Index">Chat</a>
            <a asp-controller="ShippingKnowledge" asp-action="Add">Add item</a>
            <a asp-controller="ShippingKnowledge" asp-action="Items">View items</a>
        </nav>
    </header>
    <main class="knowledge-shell">
        @RenderBody()
    </main>
</body>
</html>
